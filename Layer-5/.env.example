# ============================================================
# Layer-5 dashboard — environment template (Vite).
# Copy to `.env.local` (gitignored) to override. Vite only exposes vars
# prefixed with VITE_ to the browser.
#   cp .env.example .env.local
# ============================================================

# Base URL of the Layer-3 dashboard gateway (SSE + REST). Default is
# http://localhost:8200, so you only need this if the backend runs elsewhere.
# VITE_GATEWAY_URL=http://localhost:8200
