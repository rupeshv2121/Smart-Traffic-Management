# ============================================================
# Layer-3 STM — environment template.
# Copy to `.env` (gitignored) and uncomment what you need.
#   cp .env.example .env
# Everything has a safe default, so an empty .env runs the full stack on
# mock perception + file persistence + in-memory hot state + no tracing.
# ============================================================

# ── Upstream Layer 2 (CV perception) ────────────────────────
# PERCEPTION_URL=http://localhost:8000
# JUNCTION_ID=DEL_DL_ITO_01
# JUNCTION_LAT=28.6304
# JUNCTION_LNG=77.2177

# ── Ports ───────────────────────────────────────────────────
# DASHBOARD_PORT=8200      # Layer-5 dashboard gateway (SSE/WS/REST)
# EMV_INGEST_PORT=8100     # emergency-vehicle token intake

# ── Persistence ─────────────────────────────────────────────
# Leave DATABASE_URL unset to use the file store (.data/). Set it (or
# STORE=postgres) to use Postgres/TimescaleDB — `docker compose up -d` first.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/stm
# DATA_DIR=.data

# ── Redis hot store ─────────────────────────────────────────
# Unset = in-memory only. Set to mirror live state to Redis.
# REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=stm-delhi-dev-secret-change-me
# JWT_TTL_SECONDS=28800
# ALLOW_DEMO_LOGIN=true     # set false to force username+password
# ALLOW_SSO_STUB=true       # set false once a real IdP is wired

# ── Observability (OpenTelemetry) ───────────────────────────
# OTEL_CONSOLE=true                                   # print spans to console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces   # ship to collector
